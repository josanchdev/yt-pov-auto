# ComfyUI instance bound to the RTX 5090 (CUDA_VISIBLE_DEVICES=0) - hero shots
COMFYUI_HOST=http://127.0.0.1:8188
# ComfyUI instance bound to the RTX 3090 (CUDA_VISIBLE_DEVICES=1) - bulk / B-roll
COMFYUI_HOST_SECONDARY=http://127.0.0.1:8189
OUTPUT_ROOT=./output
LOG_LEVEL=INFO
# Optional: seed for the episode planner. Unset = derived from episode id.
# EPISODE_SEED=
